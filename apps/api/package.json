{
  "name": "@dhruto/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node dist/database/seed/seed-cli.js",
    "migration:run": "node dist/database/migrate-cli.js run",
    "migration:revert": "node dist/database/migrate-cli.js revert",
    "migration:show": "node dist/database/migrate-cli.js show",
    "db:setup": "pnpm build && pnpm migration:run && pnpm seed",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@dhruto/contracts": "workspace:*",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/typeorm": "^11.0.3",
    "@types/bcryptjs": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.40.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "express": "5.2.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@dhruto/eslint-config": "workspace:*",
    "@dhruto/tsconfig": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.20.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "typescript": "~5.8.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.0.6"
  }
}
