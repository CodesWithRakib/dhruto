# ==============================================================================
# Dhruto Logistics OS — Backend API Production Containerfile
# Multi-stage optimized build with Turborepo pruning & non-root execution
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Base image with pnpm and core dependencies
# ------------------------------------------------------------------------------
FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@12.4.2 --activate
WORKDIR /app

# ------------------------------------------------------------------------------
# Stage 2: Prune monorepo targeting @dhruto/api
# ------------------------------------------------------------------------------
FROM base AS pruner
RUN npm install -g turbo@^2
COPY . .
RUN turbo prune @dhruto/api --docker

# ------------------------------------------------------------------------------
# Stage 3: Build application & internal package dependencies
# ------------------------------------------------------------------------------
FROM base AS builder
WORKDIR /app

# Cached layer: install all dependencies for the pruned subset
COPY --from=pruner /app/out/json/ .
RUN pnpm install --frozen-lockfile

# Copy pruned source tree and build contracts then api
COPY --from=pruner /app/out/full/ .
COPY turbo.json turbo.json
RUN pnpm --filter @dhruto/contracts build
RUN pnpm --filter @dhruto/api build

# ------------------------------------------------------------------------------
# Stage 4: Lean Production Runner
# ------------------------------------------------------------------------------
FROM node:20-alpine AS runner
WORKDIR /app

RUN apk add --no-cache curl tzdata libc6-compat
ENV NODE_ENV=production
ENV TZ=Asia/Dhaka
ENV PORT=4000
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable && corepack prepare pnpm@12.4.2 --activate

# Security: Create non-root system group and user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 dhruto

# Install production-only dependencies
COPY --from=pruner --chown=dhruto:nodejs /app/out/json/ .
RUN pnpm install --prod --frozen-lockfile --ignore-scripts

# Copy compiled code from builder
COPY --from=builder --chown=dhruto:nodejs /app/packages/contracts/dist ./packages/contracts/dist
COPY --from=builder --chown=dhruto:nodejs /app/apps/api/dist ./apps/api/dist

USER dhruto

EXPOSE 4000

# Container liveness/readiness health check
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -f http://localhost:4000/health || exit 1

WORKDIR /app/apps/api
CMD ["node", "dist/main.js"]
