# ==============================================================================
# Dhruto Logistics OS — Production Environment Configuration Template
# Copy this file to .env.production on your production server and configure.
# DO NOT COMMIT THE ACTUAL .env.production FILE TO VERSION CONTROL.
# ==============================================================================

# Node Environment
NODE_ENV=production

# ------------------------------------------------------------------------------
# Ports and Public Routing
# ------------------------------------------------------------------------------
API_PORT=4000
WEB_PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=https://merchant.dhruto.com,https://admin.dhruto.com,http://localhost:5000

# Next.js Build-Time Public API URL (accessible by client browsers)
NEXT_PUBLIC_API_URL=https://api.dhruto.com/api/v1
NEXT_PUBLIC_APP_NAME=Dhruto Logistics

# ------------------------------------------------------------------------------
# PostgreSQL 16/18 High-Performance Configuration
# ------------------------------------------------------------------------------
POSTGRES_PORT=5432
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=dhruto_app
# Generate with: openssl rand -base64 32
DB_PASSWORD=replace_with_strong_production_db_password
DB_DATABASE=dhruto_production

# Direct Database URL (used by migration CLI and TypeORM)
DATABASE_URL=postgresql://${DB_USERNAME}:${DB_PASSWORD}@postgres:5432/${DB_DATABASE}

# Connection pool sizing (Keep instances * DB_POOL_MAX <= postgres max_connections)
DB_POOL_MAX=25
DB_POOL_MIN=5
DB_STATEMENT_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# Redis 7 Alpine Persistence & In-Memory Queue Broker
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_HOST=redis
REDIS_URL=redis://redis:6379
CHAT_REALTIME_REDIS_ENABLED=true

# Outbox relay poll frequency in milliseconds (event fan-out)
OUTBOX_POLL_MS=3000

# ------------------------------------------------------------------------------
# Cryptography & Security Secrets
# Generate 64-char hex strings: openssl rand -hex 32
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_64_char_hex_secret_generated_via_openssl
JWT_REFRESH_SECRET=replace_with_different_64_char_hex_secret_generated_via_openssl
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Pepper for irreversible SHA-256 phone hashing in intelligence engine
# Generate with: openssl rand -hex 32
INTELLIGENCE_PHONE_PEPPER=replace_with_unique_phone_hash_pepper_hex_secret

# ------------------------------------------------------------------------------
# External Communications (SMS & Email Providers)
# ------------------------------------------------------------------------------
# Leave blank for local development / internal log transport
SMS_PROVIDER_URL=https://api.sms-gateway.com/v1/send
SMS_PROVIDER_KEY=your_sms_gateway_bearer_token

EMAIL_PROVIDER_URL=https://api.resend.com/emails
EMAIL_PROVIDER_KEY=your_resend_api_key

# Outbound Merchant Webhooks
WEBHOOK_TIMEOUT_MS=6000
WEBHOOK_RETRY_BASE_MS=15000
WEBHOOK_MAX_ATTEMPTS=3

# Default System Notification Locale
NOTIFICATION_DEFAULT_LOCALE=bn
