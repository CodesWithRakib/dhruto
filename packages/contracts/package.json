{
  "name": "@dhruto/contracts",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@dhruto/eslint-config": "workspace:*",
    "@dhruto/tsconfig": "workspace:*",
    "eslint": "^9.20.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.6",
    "typescript": "~5.8.2",
    "vitest": "^3.0.6"
  }
}
