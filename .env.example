# Node Environment
NODE_ENV=development

# API Server Configuration
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5000

# Database Configuration (PostgreSQL)
# Local development default matches standard docker-compose / local PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/dhruto
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=dhruto

# Redis & Queue Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Outbox relay (event fan-out poll interval in milliseconds)
OUTBOX_POLL_MS=3000

# SMS provider (leave unset for the explicit log transport in development).
# When set, the HTTP transport POSTs { to, message } with a Bearer key.
SMS_PROVIDER_URL=
SMS_PROVIDER_KEY=

# Email provider (leave unset for the explicit log transport in development).
# When set, the HTTP transport POSTs { to, subject, text, html? } with a Bearer key.
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_KEY=

# Webhook delivery (outbound Dhruto -> merchant).
# Strict per-attempt timeout so one merchant endpoint can never hold a worker.
WEBHOOK_TIMEOUT_MS=6000
# Base delay for exponential webhook retry (2^attempts * base).
WEBHOOK_RETRY_BASE_MS=15000
# Maximum webhook delivery attempts per event (then dead-letter).
WEBHOOK_MAX_ATTEMPTS=3

# Notification defaults (locale fallback when no preference row exists).
NOTIFICATION_DEFAULT_LOCALE=en

# Intelligence phone-hash pepper (HMAC key for recipient identity hashing).
# Set a long random value in production; never commit the real value.
INTELLIGENCE_PHONE_PEPPER=

# JWT Authentication
JWT_ACCESS_SECRET=dhruto_dev_jwt_access_secret_change_in_production_32chars
JWT_REFRESH_SECRET=dhruto_dev_jwt_refresh_secret_change_in_production_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Web Merchant Application Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=Dhruto Merchant Portal
