# ==============================================================================
# Dhruto Logistics OS — Web Merchant Portal Production Containerfile
# Multi-stage optimized build with Next.js Standalone output & non-root runner
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Base image with pnpm and core dependencies
# ------------------------------------------------------------------------------
FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@12.4.2 --activate
WORKDIR /app

# ------------------------------------------------------------------------------
# Stage 2: Prune monorepo targeting @dhruto/web-merchant
# ------------------------------------------------------------------------------
FROM base AS pruner
RUN npm install -g turbo@^2
COPY . .
RUN turbo prune @dhruto/web-merchant --docker

# ------------------------------------------------------------------------------
# Stage 3: Build application & UI package dependencies
# ------------------------------------------------------------------------------
FROM base AS builder
WORKDIR /app

# Cached layer: install all dependencies for the pruned subset
COPY --from=pruner /app/out/json/ .
RUN pnpm install --frozen-lockfile

# Copy pruned source tree and build internal monorepo packages
COPY --from=pruner /app/out/full/ .
COPY turbo.json turbo.json
RUN pnpm --filter @dhruto/contracts build
RUN pnpm --filter @dhruto/ui build

# Next.js build-time public environment configuration
ARG NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
ARG NEXT_PUBLIC_APP_NAME="Dhruto Logistics"
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME
ENV NEXT_TELEMETRY_DISABLED=1

RUN pnpm --filter @dhruto/web-merchant build

# ------------------------------------------------------------------------------
# Stage 4: Lean Production Runner using Next.js Standalone Output
# ------------------------------------------------------------------------------
FROM node:20-alpine AS runner
WORKDIR /app

RUN apk add --no-cache curl tzdata
ENV NODE_ENV=production
ENV TZ=Asia/Dhaka
ENV PORT=5000
ENV HOSTNAME="0.0.0.0"
ENV NEXT_TELEMETRY_DISABLED=1

# Security: Create non-root system group and user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Standalone output contains all pre-bundled node_modules and server files
COPY --from=builder /app/apps/web-merchant/public ./apps/web-merchant/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/web-merchant/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web-merchant/.next/static ./apps/web-merchant/.next/static

USER nextjs

EXPOSE 5000

# Container liveness/readiness health check
HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:5000 || exit 1

CMD ["node", "apps/web-merchant/server.js"]
